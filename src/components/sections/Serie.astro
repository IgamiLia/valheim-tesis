---
import Layout from "@layouts/Layout.astro";
import { queryDatoCMS } from "@lib/datocms";

interface DatoCover {
  url: string;
  alt: string | null;
}

interface Episode {
  id: string;
  number: number;
  episode: string;
  title: string;
  duration: string;
  description: string;
  behindTheScenes: string;
  releaseDate: string;
  tiktokUrl: string;
  ytUrl: string;
  cover: DatoCover | null;
}

const EPISODES_QUERY = `
    query AllEpisodes {
        allEpisodes(orderBy: number_ASC) {
            id
            number
            episode
            title
            description
            duration
            behindTheScenes
            releaseDate
            tiktokUrl
            ytUrl
            cover {
                url
                alt
            }
        }
    }
`;

const data = (await queryDatoCMS(EPISODES_QUERY)) as { allEpisodes: Episode[] };
const episodes = data.allEpisodes;

if (!episodes.length) {
  throw new Error("[Serie.astro] No se encontraron episodios en DatoCMS.");
}

function formatDate(dateStr: string): string {
  if (!dateStr) return "";
  const date = new Date(dateStr);
  return date.toLocaleDateString("es-AR", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
}

function formatDuration(raw: string): string {
  const secs = Number(raw);
  if (!isNaN(secs) && secs > 0) {
    const h = Math.floor(secs / 3600);
    const m = Math.floor((secs % 3600) / 60);
    const s = secs % 60;
    if (h > 0)
      return `${h}:${String(m).padStart(2, "0")}:${String(s).padStart(2, "0")}`;
    return `${m}:${String(s).padStart(2, "0")}`;
  }
  return raw;
}

/**
 * Las covers de DatoCMS tienen ratios mixtos (9:16, ~2:3…). Se normalizan
 * vía imgix: `fit=fill` + `fill=blur` encaja la imagen completa en el ratio
 * pedido y rellena los bordes con una extensión difuminada (sin recortes ni
 * bandas negras). `auto=format` sirve AVIF/WebP según el navegador.
 */
function coverSrc(
  url: string | null | undefined,
  w: number,
  h: number,
): string {
  if (!url) return "";
  return `${url}?w=${w}&h=${h}&fit=fill&fill=blur&auto=format`;
}
---

<Layout>
  <div class="serie-wrapper">
    <div class="cinematic-bg" aria-hidden="true">
      <div class="bg-orb bg-orb--1"></div>
      <div class="bg-orb bg-orb--2"></div>
      <div class="bg-grain"></div>
    </div>

    <header class="serie-header">
      <div class="header-inner">
        <p class="serie-label">
          <span class="label-line"></span>
          Web Serie
          <span class="label-line"></span>
        </p>
        <h1 class="serie-title">Valheim: Larga vida a La Reina</h1>
        <p class="serie-count">{episodes.length} episodios</p>
      </div>
    </header>

    <div class="serie-stage">
      <!-- Episodio destacado -->
      <div class="featured">
        {
          episodes.map((ep, i) => (
            <article
              class={`featured-episode ${i === 0 ? "active" : ""}`}
              data-ep={ep.number}
              data-title={ep.title}
              data-description={ep.description}
              data-bts={ep.behindTheScenes}
              data-date={formatDate(ep.releaseDate)}
              data-tiktok={ep.tiktokUrl}
              data-yt={ep.ytUrl}
              data-duration={ep.duration}
              data-cover={coverSrc(ep.cover?.url, 810, 1440)}
            />
          ))
        }

        <!-- Contenido del episodio activo (actualizado por JS) -->
        <div class="featured-inner">
          <div class="featured-cover-wrap">
            <div class="cover-frame">
              <img
                id="featured-cover"
                src={coverSrc(episodes[0].cover?.url, 810, 1440)}
                alt={episodes[0].cover?.alt ?? episodes[0].title}
                class="featured-cover-img"
              />
              <iframe
                id="featured-video"
                class="featured-video"
                title={episodes[0].title}
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
                loading="lazy"
                hidden></iframe>
              <button
                id="play-btn"
                class="play-btn"
                type="button"
                aria-label="Reproducir video"
                hidden={!episodes[0].ytUrl}
              >
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M8 5v14l11-7z"></path>
                </svg>
              </button>
            </div>
            <div class="cover-shadow" aria-hidden="true"></div>
          </div>

          <div class="featured-info">
            <div class="info-top">
              <span class="ep-badge" id="ep-badge">
                Episodio {episodes[0].number}
              </span>
              <h2 class="ep-title" id="ep-title">
                {episodes[0].title}
              </h2>
              <p class="ep-date" id="ep-date">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                >
                  <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                {formatDate(episodes[0].releaseDate)}
              </p>
            </div>

            <div class="info-mid">
              <div class="info-block">
                <p class="info-label">Sinopsis</p>
                <p class="ep-description" id="ep-description">
                  {episodes[0].description}
                </p>
              </div>
              <p class="ep-date" id="ep-duration">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                >
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                Duración: {formatDuration(episodes[0].duration)}
              </p>
            </div>

            <div class="info-bottom">
              <a
                id="ep-tiktok-link"
                href={episodes[0].tiktokUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="tiktok-btn"
              >
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path
                    d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.95a8.28 8.28 0 004.84 1.55V7.05a4.85 4.85 0 01-1.07-.36z"
                  ></path>
                </svg>
                Ver en TikTok
                <svg
                  class="arrow"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>

              <nav class="ep-nav">
                <button
                  id="btn-prev"
                  class="nav-btn"
                  disabled
                  aria-label="Anterior"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <polyline points="15 18 9 12 15 6"></polyline>
                  </svg>
                </button>

                <div class="ep-input-wrap">
                  <input
                    type="number"
                    id="ep-input"
                    class="ep-input"
                    min="1"
                    max={episodes.length}
                    value={1}
                    aria-label="Número de episodio"
                  />
                  <span class="ep-total">/ {episodes.length}</span>
                </div>

                <button
                  id="btn-next"
                  class="nav-btn"
                  disabled={episodes.length === 1}
                  aria-label="Siguiente"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <polyline points="9 18 15 12 9 6"></polyline>
                  </svg>
                </button>
              </nav>
            </div>
          </div>
        </div>
      </div>

      <!-- Catálogo -->
      <section class="catalogue" aria-label="Lista de episodios">
        <div class="catalogue-header">
          <h3 class="catalogue-title">Todos los episodios</h3>
          <div class="catalogue-line"></div>
        </div>
        <div class="catalogue-grid" id="catalogue-grid">
          {
            episodes.map((ep, i) => (
              <button
                class={`catalogue-card ${i === 0 ? "active" : ""}`}
                data-index={i}
                aria-label={`Ver episodio ${ep.number}: ${ep.title}`}
                style={`animation-delay: ${i * 0.04}s`}
              >
                <div class="card-thumb">
                  {ep.cover ? (
                    <img
                      src={coverSrc(ep.cover.url, 432, 672)}
                      alt={ep.cover.alt ?? ep.title}
                      loading="lazy"
                    />
                  ) : (
                    <div class="card-thumb-placeholder">
                      <span>{ep.number}</span>
                    </div>
                  )}
                  <div class="card-overlay">
                    <span class="card-ep-num">Ep. {ep.number}</span>
                  </div>
                  <div class="card-active-bar" />
                </div>
                <div class="card-info">
                  <span class="card-episode">{ep.episode}</span>
                  <span class="card-title">{ep.title}</span>
                  {ep.releaseDate && (
                    <span class="card-date">{formatDate(ep.releaseDate)}</span>
                  )}
                </div>
              </button>
            ))
          }
        </div>
      </section>
    </div>
  </div>
</Layout>

<script>
  type EpisodeData = {
    number: string;
    title: string;
    description: string;
    bts: string;
    date: string;
    tiktok: string;
    yt: string;
    duration: string;
    cover: string;
  };

  function formatDuration(raw: string): string {
    const secs = Number(raw);
    if (!isNaN(secs) && secs > 0) {
      const h = Math.floor(secs / 3600);
      const m = Math.floor((secs % 3600) / 60);
      const s = secs % 60;
      if (h > 0)
        return `${h}:${String(m).padStart(2, "0")}:${String(s).padStart(2, "0")}`;
      return `${m}:${String(s).padStart(2, "0")}`;
    }
    return raw;
  }

  // Se ejecuta en la carga inicial y tras cada navegación con view
  // transitions (astro:page-load), porque los <script> de página no se
  // re-ejecutan solos al navegar con <ClientRouter />.
  function initSerie() {
    const cards =
      document.querySelectorAll<HTMLButtonElement>(".catalogue-card");
    const articles =
      document.querySelectorAll<HTMLElement>(".featured-episode");
    if (!articles.length) return;

    const coverImg = document.getElementById(
      "featured-cover",
    ) as HTMLImageElement;
    const featuredVideo = document.getElementById(
      "featured-video",
    ) as HTMLIFrameElement;
    const playBtn = document.getElementById("play-btn") as HTMLButtonElement;
    const epBadge = document.getElementById("ep-badge")!;
    const epTitle = document.getElementById("ep-title")!;
    const epDate = document.getElementById("ep-date")!;
    const epDuration = document.getElementById("ep-duration")!;
    const epDesc = document.getElementById("ep-description")!;
    const tiktokBtn = document.getElementById(
      "ep-tiktok-link",
    ) as HTMLAnchorElement;
    const btnPrev = document.getElementById("btn-prev") as HTMLButtonElement;
    const btnNext = document.getElementById("btn-next") as HTMLButtonElement;
    const epInput = document.getElementById("ep-input") as HTMLInputElement;

    let current = 0;

    function getEpisodeData(index: number): EpisodeData {
      const el = articles[index];
      return {
        number: el.dataset.ep ?? "",
        title: el.dataset.title ?? "",
        description: el.dataset.description ?? "",
        bts: el.dataset.bts ?? "",
        date: el.dataset.date ?? "",
        tiktok: el.dataset.tiktok ?? "",
        yt: el.dataset.yt ?? "",
        duration: el.dataset.duration ?? "",
        cover: el.dataset.cover ?? "",
      };
    }

    // Carga el iframe (con autoplay) sobre la portada al pulsar play.
    function playVideo() {
      const yt = getEpisodeData(current).yt;
      if (!yt) return;
      const sep = yt.includes("?") ? "&" : "?";
      featuredVideo.src = `${yt}${sep}autoplay=1&playsinline=1`;
      featuredVideo.hidden = false;
      // La cover queda debajo del iframe (opaco): no se oculta para que
      // el frame conserve su altura (ahora depende de la imagen en flujo).
      playBtn.hidden = true;
    }

    playBtn.addEventListener("click", playVideo);

    function loadEpisode(index: number) {
      if (index < 0 || index >= articles.length) return;
      current = index;

      const ep = getEpisodeData(index);

      // Vuelve al estado "portada": descarga el iframe y muestra la cover
      featuredVideo.hidden = true;
      featuredVideo.removeAttribute("src");
      coverImg.src = ep.cover;
      coverImg.alt = ep.title;
      coverImg.hidden = false;
      playBtn.hidden = !ep.yt;

      epBadge.textContent = `Episodio ${ep.number}`;
      epTitle.textContent = ep.title;
      epDesc.textContent = ep.description;
      tiktokBtn.href = ep.tiktok;

      // Fecha (preserva el ícono SVG)
      const dateIcon = epDate.querySelector("svg")!.outerHTML;
      epDate.innerHTML = dateIcon + " " + ep.date;

      // Duración (preserva el ícono SVG)
      const durationIcon = epDuration.querySelector("svg")!.outerHTML;
      epDuration.innerHTML =
        durationIcon + " Duración: " + formatDuration(ep.duration);

      epInput.value = ep.number;
      btnPrev.disabled = index === 0;
      btnNext.disabled = index === articles.length - 1;

      cards.forEach((c, i) => c.classList.toggle("active", i === index));

      document
        .querySelector(".featured-inner")
        ?.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    btnPrev.addEventListener("click", () => loadEpisode(current - 1));
    btnNext.addEventListener("click", () => loadEpisode(current + 1));

    epInput.addEventListener("change", () => {
      const num = parseInt(epInput.value, 10);
      const idx = Array.from(articles).findIndex(
        (a) => Number(a.dataset.ep) === num,
      );
      if (idx !== -1) loadEpisode(idx);
      else epInput.value = articles[current].dataset.ep ?? "1";
    });

    cards.forEach((card, i) =>
      card.addEventListener("click", () => loadEpisode(i)),
    );
  }

  document.addEventListener("astro:page-load", initSerie);
</script>

<style>
  /* ── Wrapper ── */
  .serie-wrapper {
    position: relative;
    min-height: 100vh;
    background: var(--dark);
    color: var(--text);
    overflow-x: hidden;
  }

  /* ── Fondo ── */
  .cinematic-bg {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .bg-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
  }

  .bg-orb--1 {
    width: 600px;
    height: 600px;
    top: -200px;
    left: 50%;
    transform: translateX(-50%);
    background: radial-gradient(
      circle,
      rgba(180, 151, 76, 0.06) 0%,
      transparent 70%
    );
  }

  .bg-orb--2 {
    width: 400px;
    height: 400px;
    bottom: 10%;
    right: -100px;
    background: radial-gradient(
      circle,
      rgba(180, 151, 76, 0.04) 0%,
      transparent 70%
    );
  }

  .bg-grain {
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
    opacity: 0.4;
  }

  /* ── Header ── */
  .serie-header {
    position: relative;
    z-index: 1;
    padding: 6rem 5rem 2.5rem;
    border-bottom: 1px solid var(--gold-dim);
  }

  .header-inner {
    width: 100%;
  }

  .serie-label {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-size: clamp(0.75rem, 0.4545vw + 0.6591rem, 1rem);
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin: 0 0 1rem;
  }

  .label-line {
    flex: 0 0 2rem;
    height: 1px;
    background: var(--gold-dim);
  }

  .serie-title {
    font-size: clamp(1.8rem, 4vw + 1rem, 4rem);
    font-weight: 400;
    margin: 0 0 1rem;
    letter-spacing: 0.01em;
    line-height: 1.1;
  }

  .serie-count {
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    color: var(--text-muted);
    margin: 0;
    text-transform: uppercase;
  }

  /* ── Stage ── */
  .serie-stage {
    position: relative;
    z-index: 1;
    padding: 4rem 5rem 8rem;
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  /* ── Featured ── */
  .featured {
    position: relative;
  }

  .featured-episode {
    display: none;
  }

  .featured-inner {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 4rem;
    align-items: start;
  }

  /* ── Cover ── */
  .featured-cover-wrap {
    position: relative;
    flex-shrink: 0;
  }

  /* 9:16 fijo: coincide con los Shorts (iframe sin bandas) y las covers
     llegan ya normalizadas a ese ratio desde imgix (coverSrc). */
  .cover-frame {
    position: relative;
    width: clamp(280px, calc(236.364px + 13.636vw), 400px);
    aspect-ratio: 9 / 16;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface-2);
    box-shadow:
      0 0 0 2px var(--gold-dim),
      0 30px 80px rgba(0, 0, 0, 0.8);
  }

  /* Portada (poster) de cada episodio */
  .featured-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Iframe del short: superpuesto, llena el contenedor 9:16 al reproducir */
  .featured-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
    display: block;
    z-index: 3;
  }

  .featured-video[hidden] {
    display: none;
  }

  /* Botón de play sobre la portada */
  .play-btn {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 4rem;
    height: 4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.45);
    border: 1px solid var(--color-gold);
    color: var(--color-gold);
    cursor: pointer;
    z-index: 4;
    transition:
      background var(--transition),
      color var(--transition),
      box-shadow var(--transition),
      transform var(--transition);
  }

  .play-btn[hidden] {
    display: none;
  }

  .play-btn:hover {
    background: var(--color-gold);
    color: var(--dark);
    box-shadow: 0 0 24px var(--gold-glow);
    transform: scale(1.05);
  }

  .play-btn svg {
    width: 1.6rem;
    height: 1.6rem;
    margin-left: 3px;
  }

  .cover-shadow {
    position: absolute;
    bottom: -30px;
    left: 50%;
    transform: translateX(-50%);
    width: 80%;
    height: 30px;
    background: radial-gradient(
      ellipse,
      rgba(0, 0, 0, 0.5) 0%,
      transparent 70%
    );
    filter: blur(10px);
  }

  /* ── Info ── */
  .featured-info {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    padding-top: 0.5rem;
    min-height: min(448px, 53vw);
    justify-content: space-between;
  }

  .info-top {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .ep-badge {
    display: inline-block;
    font-size: 0.65rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--color-gold);
    border: 1px solid var(--gold-dim);
    padding: 0.25rem 0.7rem;
    border-radius: 2px;
    width: fit-content;
  }

  .ep-title {
    font-size: clamp(1.6rem, 1.6364vw + 1.2727rem, 2.5rem);
    font-weight: 400;
    margin: 0;
    line-height: 1.15;
    letter-spacing: 0.01em;
  }

  .ep-date {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: clamp(0.78rem, 0.4vw + 0.7rem, 1rem);
    color: var(--text-muted);
    letter-spacing: 0.08em;
    margin: 0;
  }

  .ep-date svg {
    width: 16px;
    aspect-ratio: 1/1;
    flex-shrink: 0;
    color: var(--color-gold);
  }

  .info-mid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .info-block {
    padding-left: 1rem;
    border-left: 1px solid var(--gold-dim);
  }

  .info-label {
    font-size: clamp(0.75rem, 0.6364vw + 0.6227rem, 1.1rem);
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin: 0 0 0.5rem;
  }

  .ep-description,
  .ep-bts {
    margin: 0;
    font-size: clamp(0.9rem, 0.7273vw + 0.7545rem, 1.3rem);
    line-height: 1.8;
    color: var(--text-muted);
  }

  /* ── Bottom (botón + nav) ── */
  .info-bottom {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .tiktok-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: transparent;
    border: 1px solid var(--color-gold);
    color: var(--color-gold);
    padding: 0.6rem 1.2rem;
    border-radius: var(--radius);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    font-family: inherit;
    transition:
      background var(--transition),
      color var(--transition),
      box-shadow var(--transition);
  }

  .tiktok-btn:hover {
    background: var(--color-gold);
    color: var(--dark);
    box-shadow: 0 0 20px var(--gold-glow);
  }

  .tiktok-btn svg {
    width: 15px;
