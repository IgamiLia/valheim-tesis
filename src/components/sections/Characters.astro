---
import SectionDivider from "@components/ui/SectionDivider.astro";
import CharacterCard from "@components/ui/CharacterCard.astro";
import FixedBackground from "@components/ui/FixedBackground.astro";
const characters = [
  {
    name: "Einar",
    img: "/images/cards/card-einar.png",
  },
  {
    name: "Runa",
    img: "/images/cards/card-runa.png",
  },
  {
    name: "Hel",
    img: "/images/cards/card-hel.png",
  },
  {
    name: "Stalker",
    img: "/images/cards/card-stalker.png",
  },
  {
    name: "Moder",
    img: "/images/cards/card-moder.png",
  },
  {
    name: "Fader",
    img: "/images/cards/card-fader.png",
  },
];
---

<section class="characters-section">
  <FixedBackground
    image="/images/backgrounds/characters-bg.png"
    imageMobile="/images/backgrounds/characters-bg-mobile.png"
    brightness={0.5}
    pinMobile
  />

  <picture class="characters-logo-pic">
    <source srcset="/images/logos/characters-title.avif" type="image/avif" />
    <source srcset="/images/logos/characters-title.webp" type="image/webp" />
    <img
      id="characters-logo"
      src="/images/logos/characters-title.png"
      alt="Logo de Personajes"
      loading="lazy"
      decoding="async"
    />
  </picture>

  <main>
    {
      characters.map((char, i) => (
        <CharacterCard name={char.name} img={char.img} index={i} />
      ))
    }
  </main>
</section>
<div class="presentation hidden">
  <div class="presentation__text hidden"></div>
  <div class="presentation__card"></div>
  <div class="presentation__character"></div>
</div>

<section class="modal hidden">
  <div class="overlay hidden"></div>
</section>

<SectionDivider />

<script>
  // Prefetch en idle de las cards (AVIF) para que estén en caché antes de
  // verse, sin competir con la carga crítica del Hero.
  (() => {
    const slugs = ["einar", "runa", "hel", "stalker", "moder", "fader"];
    const warm = () =>
      slugs.forEach((s) => {
        const img = new Image();
        img.src = `/images/cards/card-${s}.avif`;
      });
    if ("requestIdleCallback" in window)
      requestIdleCallback(warm, { timeout: 3000 });
    else setTimeout(warm, 1500);
  })();
</script>

<style>
  /* El wrapper <picture> del logo no debe afectar el layout */
  .characters-logo-pic {
    display: contents;
  }

  .characters-section {
    position: relative;
    width: 100%;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    transform: translateZ(0);
  }

  #characters-logo {
    margin-top: 8rem;
  }

  main {
    margin-bottom: 12rem;
  }

  @media (max-width: 768px) {
    #characters-logo {
      margin-top: 5rem;
    }

    main {
      margin-bottom: 8rem;
    }
  }
</style>