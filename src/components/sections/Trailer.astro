---
import SectionDivider from "@components/ui/SectionDivider.astro";
import FixedBackground from "@components/ui/FixedBackground.astro";
---

<section id="trailer">
  <FixedBackground
    image="/images/backgrounds/png/trailer-bg.png"
    imageMobile="/images/backgrounds/png/trailer-bg-mobile.png"
    brightness={1}
  />
  <div class="trailer-bg" aria-hidden="true"></div>

  <div class="trailer-inner">
    <header class="trailer-header">
      <span class="rune-deco" aria-hidden="true">ᚠ ✦ ᛟ ✦ ᚢ</span>
      <h2 class="trailer-title">TRAILER</h2>
      <div class="title-underline" aria-hidden="true"></div>
    </header>

    <div class="content-row">
      <div class="frame-wrap">
        <div class="corner corner-tl" aria-hidden="true"></div>
        <div class="corner corner-tr" aria-hidden="true"></div>
        <div class="corner corner-bl" aria-hidden="true"></div>
        <div class="corner corner-br" aria-hidden="true"></div>

        <div class="iframe-shell">
          <!-- Portada: el iframe de YouTube solo se carga al pulsar play
               (mismo patrón que las portadas de Serie) -->
          <picture>
            <source
              srcset="/images/trailer/avif/trailer-portrait.avif"
              type="image/avif"
            />
            <source
              srcset="/images/trailer/webp/trailer-portrait.webp"
              type="image/webp"
            />
            <img
              id="trailer-poster"
              class="trailer-poster"
              src="/images/trailer/webp/trailer-portrait.webp"
              alt="Portada del tráiler de Valheim: Larga vida a La Reina"
              width="941"
              height="1672"
              loading="lazy"
              decoding="async"
            />
          </picture>

          <button
            id="trailer-play"
            class="play-btn"
            type="button"
            aria-label="Reproducir tráiler"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M8 5v14l11-7z"></path>
            </svg>
          </button>

          <iframe
            id="trailer-video"
            data-src="https://youtube.com/embed/QCZ85PqcfV4?autoplay=1&playsinline=1"
            title="Trailer — Valheim: Larga vida a La Reina"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
            loading="lazy"
            hidden></iframe>
        </div>
      </div>

      <div class="sinopsis">
        <h3 class="sinopsis-title">SINOPSIS</h3>
        <p>
          Dos hermanos, <strong>Runa</strong> y <strong>Einar</strong>, viven
          tranquilos en un pueblo aislado de Midgard hasta que un hecho cambia
          sus vidas: la Reina del Inframundo, <strong>Hel</strong>, secuestra a
          Runa para desencadenar sus poderes ocultos. Einar, consumido por la
          furia, decide hacerse más fuerte para enfrentarla. Sin embargo, al
          llegar a sus tierras descubre que deberá
          <strong>luchar contra su propia hermana para salvarla</strong>.
        </p>
      </div>
    </div>

    <p class="trailer-caption">
      <img
        class="caption-rune"
        src="/svg/rune-icon.svg"
        alt=""
        aria-hidden="true"
      />
      Valheim: Larga vida a La Reina
      <img
        class="caption-rune reverse"
        src="/svg/rune-icon.svg"
        alt=""
        aria-hidden="true"
      />
    </p>
  </div>
</section>
<SectionDivider />

<script>
  // La portada evita cargar el embed de YouTube (~1 MB de JS de terceros)
  // hasta que el usuario pulsa play. La cover queda debajo del iframe opaco.
  function initTrailer() {
    const playBtn = document.getElementById(
      "trailer-play",
    ) as HTMLButtonElement | null;
    const video = document.getElementById(
      "trailer-video",
    ) as HTMLIFrameElement | null;
    if (!playBtn || !video) return;

    playBtn.addEventListener(
      "click",
      () => {
        video.src = video.dataset.src ?? "";
        video.hidden = false;
        playBtn.hidden = true;
      },
      { once: true },
    );
  }

  document.addEventListener("astro:page-load", initTrailer);
</script>

<style>
  section {
    position: relative;
    width: 100vw;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    scroll-snap-align: start;
    overflow: hidden;
    /* Contiene el FixedBackground (fixed) dentro de la sección */
    transform: translateZ(0);
  }

  /* Capa oscura encima del fondo */
  .trailer-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(8, 7, 6, 0.78) 0%,
      rgba(8, 7, 6, 0.62) 50%,
      rgba(8, 7, 6, 0.82) 100%
    );
    z-index: 0;
  }

  .trailer-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4rem;
    padding: 15rem 0;
  }

  /* ── Encabezado ─────────────────────────────────────────────────────────── */

  .trailer-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }

  .rune-deco {
    font-family: var(--font-display);
    font-size: clamp(0.75rem, 1.2vw, 1rem);
    letter-spacing: 0.6rem;
    color: var(--color-gold-dark);
    opacity: 0.7;
    text-shadow: 0 0 12px rgba(130, 103, 40, 0.5);
  }

  .trailer-title {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 7vw, 6rem);
    font-weight: 700;
    color: transparent;
    -webkit-text-stroke: 1.2px var(--color-gold-light);
    text-shadow:
      0 0 32px rgba(180, 151, 76, 0.4),
      0 0 64px rgba(130, 103, 40, 0.2);
    letter-spacing: 0.35em;
    margin: 0;
    line-height: 1;
  }

  .title-underline {
    width: clamp(120px, 20vw, 280px);
    height: 1px;
    background: linear-gradient(
      to right,
      transparent,
      var(--color-gold-dark) 20%,
      var(--color-gold) 50%,
      var(--color-gold-dark) 80%,
      transparent
    );
    margin-top: 0.3rem;
  }

  /* ── Fila contenido ────────────────────────────────────────────────────── */

  .content-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 4rem;
  }

  /* ── Sinopsis ───────────────────────────────────────────────────────────── */

  .sinopsis {
    max-width: 600px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .sinopsis-title {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 2.4rem);
    font-weight: 700;
    color: transparent;
    -webkit-text-stroke: 1px var(--color-gold-light);
    text-shadow:
      0 0 24px rgba(180, 151, 76, 0.4),
      0 0 48px rgba(130, 103, 40, 0.2);
    letter-spacing: 0.3em;
    margin: 0;
    display: block;
  }

  .sinopsis-title::after {
    content: "";
    display: block;
    width: 100%;
    height: 1px;
    margin-top: 0.6rem;
    background: linear-gradient(
      to right,
      var(--color-gold-dark) 0%,
      var(--color-gold) 40%,
      var(--color-gold-dark) 80%,
      transparent 100%
    );
  }

  .sinopsis p {
    font-size: clamp(1.1rem, 1.9vw, 1.6rem);
    line-height: 1.9;
    color: rgb(225, 210, 178);
    letter-spacing: 0.025em;
    text-wrap: pretty;
    margin: 0;
    text-shadow:
      0 0 20px rgba(0, 0, 0, 0.95),
      0 1px 2px rgba(0, 0, 0, 1);
  }

  .sinopsis p strong {
    color: rgb(222, 196, 128);
    font-weight: 600;
  }

  /* ── Marco del iframe ───────────────────────────────────────────────────── */

  .frame-wrap {
    position: relative;
    flex-shrink: 0;
  }

  /* Esquinas doradas */
  .corner {
    position: absolute;
    width: var(--card-corner-size, 36px);
    height: var(--card-corner-size, 36px);
    pointer-events: none;
    z-index: 2;
  }

  .corner-tl {
    top: calc(var(--card-corner-offset, -6px));
    left: calc(var(--card-corner-offset, -6px));
    border-top: var(--card-border-width, 2px) solid var(--color-gold);
    border-left: var(--card-border-width, 2px) solid var(--color-gold);
    box-shadow: -2px -2px 8px var(--color-gold-glow);
  }

  .corner-tr {
    top: calc(var(--card-corner-offset, -6px));
    right: calc(var(--card-corner-offset, -6px));
    border-top: var(--card-border-width, 2px) solid var(--color-gold);
    border-right: var(--card-border-width, 2px) solid var(--color-gold);
    box-shadow: 2px -2px 8px var(--color-gold-glow);
  }

  .corner-bl {
    bottom: calc(var(--card-corner-offset, -6px));
    left: calc(var(--card-corner-offset, -6px));
    border-bottom: var(--card-border-width, 2px) solid var(--color-gold);
    border-left: var(--card-border-width, 2px) solid var(--color-gold);
    box-shadow: -2px 2px 8px var(--color-gold-glow);
  }

  .corner-br {
    bottom: calc(var(--card-corner-offset, -6px));
    right: calc(var(--card-corner-offset, -6px));
    border-bottom: var(--card-border-width, 2px) solid var(--color-gold);
    border-right: var(--card-border-width, 2px) solid var(--color-gold);
    box-shadow: 2px 2px 8px var(--color-gold-glow);
  }

  .iframe-shell {
    position: relative;
    border: 2px solid var(--color-gold-dark);
    box-shadow:
      0 0 0 1px rgba(10, 9, 6, 0.8),
      0 0 0 4px var(--color-gold-dark),
      0 0 40px 4px rgba(130, 103, 40, 0.35),
      inset 0 1px 0 rgba(220, 195, 120, 0.08);
    border-radius: 2px;
    overflow: hidden;
    background: #000;
    aspect-ratio: 9 / 16;
    width: clamp(280px, 38vw, 480px);
  }

  /* Portada del tráiler (mismo ratio 9:16 que el shell) */
  .trailer-poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Botón de play sobre la portada (mismo lenguaje que en Serie) */
  .play-btn {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 4rem;
    height: 4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.45);
    border: 1px solid var(--color-gold);
    color: var(--color-gold);
    cursor: pointer;
    z-index: 3;
    transition:
      background 0.25s ease,
      color 0.25s ease,
      box-shadow 0.25s ease,
      transform 0.25s ease;
  }

  .play-btn[hidden] {
    display: none;
  }

  .play-btn:hover {
    background: var(--color-gold);
    color: #0a0906;
    box-shadow: 0 0 24px var(--color-gold-glow);
    transform: scale(1.05);
  }

  .play-btn svg {
    width: 1.6rem;
    height: 1.6rem;
    margin-left: 3px;
  }

  iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    border: none;
    z-index: 2;
  }

  iframe[hidden] {
    display: none;
  }

  /* ── Caption ────────────────────────────────────────────────────────────── */

  .trailer-caption {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-family: var(--font-display);
    font-size: clamp(0.7rem, 1vw, 0.9rem);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-gold-dark);
    opacity: 0.75;
    margin: 0;
  }

  .caption-rune {
    width: 1.3em;
    height: auto;
    flex-shrink: 0;
    vertical-align: middle;
    opacity: 0.6;
  }
  .reverse {
    transform: scaleX(-1);
  }

  /* ── Mobile ─────────────────────────────────────────────────────────────── */

  @media (max-width: 900px) {
    .content-row {
      flex-direction: column;
      gap: 2.5rem;
    }

    .sinopsis {
      max-width: 80vw;
      align-items: center;
    }

    .sinopsis-title {
      text-align: center;
    }

    .sinopsis p {
      text-align: start;
    }
  }

  @media (max-width: 768px) {
    .trailer-inner {
      padding: 5rem 0;
      gap: 3rem;
    }

    .iframe-shell {
      width: clamp(240px, 70vw, 380px);
    }

    .trailer-title {
      letter-spacing: 0.2em;
      -webkit-text-stroke-width: 0.8px;
    }

    .rune-deco {
      letter-spacing: 0.35rem;
    }

    .trailer-caption {
      letter-spacing: 0.15em;
      text-align: center;
    }
  }

  @media (max-width: 480px) {
    .trailer-inner {
      gap: 2rem;
      padding: 3.5rem 0;
    }

    .iframe-shell {
      width: clamp(220px, 85vw, 340px);
    }

    .corner {
      width: 24px;
      height: 24px;
    }

    .trailer-caption {
      font-size: 0.65rem;
    }
  }
</style>
