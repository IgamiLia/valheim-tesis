---
import SectionDivider from "@components/ui/SectionDivider.astro";
import FixedBackground from "@components/ui/FixedBackground.astro";
import Contenido from "@components/sections/Contenido.astro";
---

<section>
    <FixedBackground
      image="/images/backgrounds/png/hero-bg.png"
      imageMobile="/images/backgrounds/png/hero-bg-mobile.png"
      pinMobile
    />
    <main>
      <picture class="logo-pic">
        <source srcset="/images/logos/avif/hero-logo.avif" type="image/avif" />
        <img
          class="logo"
          src="/images/logos/webp/hero-logo.webp"
          alt="Valheim: Larga vida a La Reina"
          fetchpriority="high"
        />
      </picture>

      <div class="text-wrap">
        <div class="vignette"></div>
        <h1 class="parallax-text">
          Bienvenidos a la wiki de Valheim: Larga vida a la Reina
        </h1>
      </div>

      <div class="intro-wrap">
        <p class="intro">
          <strong>Valheim: Larga vida a la Reina</strong> es una webserie dirigida
          por
          <strong
            ><a
              href="https://ailenbraga.com"
              role="link"
              target="_blank"
              rel="noopener noreferrer">Ailén Braga</a
            ></strong
          > y <strong
            ><a
              href="https://matt-s-portfolio-steel.vercel.app/"
              role="link"
              target="_blank"
              rel="noopener noreferrer">Matías Aguirre</a
            ></strong
          >, dos jugadores casuales del videojuego <a href="#">Valheim</a>,
          centrado en la supervivencia dentro de un mundo abierto inspirado en
          la
          <strong>mitología nórdica</strong>. La propuesta toma ese universo
          como base para contar una historia propia, combinando aventura,
          exploración y suspenso.
        </p>
        <p class="intro">
          El proyecto fue realizado utilizando el modo multijugador del juego
          como
          <strong>herramienta de rodaje</strong>, con el objetivo de desarrollar
          una miniserie de fantasía con fines académicos. Cada capítulo dura
          aproximadamente un minuto, pensado para un consumo rápido y dinámico.
          Los episodios están disponibles en <a href="#tk">TikTok</a> y en
          <a href="#ig">Instagram</a>, donde este último funciona como espacio
          de difusión y acompañamiento del contenido principal.
        </p>
      </div>

      <Contenido />
    </main>
  </section>
<SectionDivider />
<style>
  .logo-pic {
    display: contents;
  }

  section {
    width: 100%;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    scroll-snap-align: start;
    position: relative;
  }

  main {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    padding: 3rem;
    gap: 4rem;
  }

  .logo {
    display: block;
    margin-top: 2rem;
    margin-inline: auto;
    width: clamp(300px, 45vw, 600px);
  }

  .text-wrap {
    padding: 1rem;
    position: relative;
    width: fit-content;
    max-width: min(90vw, 40rem);
    margin: 0 auto;
    text-align: center;
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, calc(0.5rem + 2.8vw), 2.6rem);
    z-index: 2;
    position: relative;
    text-align: center;
    text-wrap: balance;
    padding: 0.5rem 2rem;
  }

  .vignette {
    position: absolute;
    inset: -10% 0%;
    z-index: 0;
    background: radial-gradient(
      ellipse at 45% 50%,
      rgba(0, 0, 0, 0.88) 0%,
      rgba(0, 0, 0, 0.72) 35%,
      rgba(0, 0, 0, 0.38) 60%,
      transparent 100%
    );
    filter: url(#roughen);
    pointer-events: none;
  }

  /* ─────────────────────────────────────────────
     Intro: mismo ancho que .index-aside, sin caja.
     Legibilidad resuelta con texto + separadores.
  ───────────────────────────────────────────── */
  .intro-wrap {
    width: 75vw;
    margin: 0 auto;
    position: relative;
  }

  /* Separador superior: línea dorada que se desvanece en los extremos */
  .intro-wrap::before {
    content: "";
    display: block;
    width: 100%;
    height: 1px;
    margin-bottom: 1.5rem;
    background: linear-gradient(
      to right,
      transparent 0%,
      rgba(180, 151, 76, 0.6) 15%,
      rgba(210, 175, 88, 0.9) 50%,
      rgba(180, 151, 76, 0.6) 85%,
      transparent 100%
    );
  }

  /* Separador inferior */
  .intro-wrap::after {
    content: "";
    display: block;
    width: 100%;
    height: 1px;
    margin-top: 1.5rem;
    background: linear-gradient(
      to right,
      transparent 0%,
      rgba(180, 151, 76, 0.6) 15%,
      rgba(210, 175, 88, 0.9) 50%,
      rgba(180, 151, 76, 0.6) 85%,
      transparent 100%
    );
  }

  .intro {
    width: 100%;
    font-size: clamp(0.95rem, calc(0.5rem + 1.45vw), 1.65rem);
    line-height: 1.9;
    color: rgb(232, 218, 190);
    letter-spacing: 0.028em;
    word-spacing: 0.06em;
    text-wrap: pretty;
    text-shadow:
      0 0 20px rgba(0, 0, 0, 0.95),
      0 0 8px rgba(0, 0, 0, 0.95),
      0 1px 2px rgba(0, 0, 0, 1),
      2px 0 8px rgba(0, 0, 0, 0.8),
      -2px 0 8px rgba(0, 0, 0, 0.8);
  }

  .intro + .intro {
    margin-top: 1.15em;
  }

  .intro strong {
    color: rgb(222, 196, 128);
    font-weight: 600;
    letter-spacing: 0.03em;
  }

  .intro a {
    color: var(--color-gold-light);
    font-weight: bold;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .intro a:hover {
    color: var(--color-gold);
    text-decoration: underline;
  }

</style>