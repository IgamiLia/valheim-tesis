---
import FixedBackground from "@components/ui/FixedBackground.astro";
---

<section>
  <FixedBackground image="/images/backgrounds/png/footer-bg.png" />
  <footer>
    <div class="redes-footer">
      <h3>Seguí la serie en nuestras redes sociales</h3>
      <div class="iconos-footer">
        <a
          href="https://www.instagram.com/valheimwebserie?igsh=Njk4Zzdic2luZzZk"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram de la webserie"
        >
          <img src="/images/icons/svg/instagram-icon.svg" alt="Instagram" />
        </a>
        <a
          href="https://www.tiktok.com/@valheimwebserie?_t=ZM-8xM7SS8YEYY&_r=1"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="TikTok de la webserie"
        >
          <img src="/images/icons/svg/tiktok-icon-dark.svg" alt="TikTok" />
        </a>
      </div>
    </div>

    <div class="contactos-footer">
      <h3>Contactos</h3>
      <span
        >Matías Aguirre <a href="mailto:matt.aguirre.dev@gmail.com"
          >matt.aguirre.dev@gmail.com</a
        ></span
      >
      <span
        >Ailen Braga <a href="mailto:ailenbragaph@gmail.com"
          >ailenbragaph@gmail.com</a
        ></span
      >
    </div>

    <div class="valheim-page-footer">
      <h3>Acerca de Valheim</h3>
      <span
        >Visitá la <a
          href="https://www.valheimgame.com/es/"
          target="_blank"
          rel="noopener noreferrer">página oficial de Valheim</a
        ></span
      >
    </div>

    <div class="creditos" aria-label="Derechos de autor y créditos">
      <p>
        © 2026 <a
          href="https://www.tiktok.com/@valheimwebserie"
          target="_blank"
          rel="noopener noreferrer">Valheim: Larga vida a la Reina</a
        >. Derechos reservados.
      </p>
      <p>
        Diseñado y desarrollado por <a
          href="https://www.ailenbraga.com/"
          target="_blank"
          rel="noopener noreferrer">Ailen Braga</a
        > y <a
          href="https://mattecocido.com/"
          target="_blank"
          rel="noopener noreferrer">Matías Aguirre</a
        >.
      </p>
    </div>
  </footer>
</section>

<style>
  section {
    width: 100%;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    scroll-snap-align: start;
    position: relative;
    padding: 6rem 0 3rem;
    transform: translateZ(0);
  }

  footer {
    width: 100%;
    max-width: 1500px;
    margin-inline: auto;
    padding: 0 clamp(1.5rem, 4vw, 4rem);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3.5rem 2rem;
    align-items: start;
    justify-items: center;
    text-align: center;
  }

  .redes-footer,
  .contactos-footer,
  .valheim-page-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.1rem;
  }

  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(0.95rem, 0.4vw + 0.85rem, 1.2rem);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-gold);
    max-width: 24ch;
    text-wrap: balance;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.8);
  }

  h3::after {
    content: "";
    display: block;
    width: 3.5rem;
    height: 1px;
    margin: 0.8rem auto 0;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(214, 170, 92, 0.75),
      transparent
    );
    box-shadow: 0 0 8px rgba(214, 150, 60, 0.35);
  }

  span {
    font-size: clamp(0.95rem, 0.35vw + 0.85rem, 1.15rem);
    line-height: 1.6;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.7);
  }

  .contactos-footer span {
    overflow-wrap: anywhere;
  }

  /* ── Links ── */
  a {
    position: relative;
    display: inline-block;
    color: var(--color-gold-light);
    text-decoration: none;
    font-weight: bold;
    transition: color 0.2s ease;
  }

  a:hover {
    color: var(--color-gold-dark);
  }

  a::after {
    position: absolute;
    content: "";
    left: 0;
    bottom: 0;
    width: 0;
    height: 2px;
    background-color: var(--color-gold-dark);
    transition: width 0.3s ease;
  }

  a:hover::after {
    width: 100%;
  }

  /* ── Iconos de redes ── */
  .iconos-footer {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
  }

  .iconos-footer a::after {
    display: none;
  }

  .iconos-footer img {
    width: 34px;
    height: 34px;
    transition:
      transform 0.3s ease,
      filter 0.3s ease;
  }

  .iconos-footer img:hover {
    transform: scale(1.15);
    filter: drop-shadow(0 0 6px var(--color-gold-light));
  }

  /* ── Créditos: separados por una línea dorada a lo ancho ── */
  .creditos {
    grid-column: 1 / -1;
    position: relative;
    width: 100%;
    margin-top: 1rem;
    padding-top: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }

  .creditos::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: min(100%, 640px);
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(214, 170, 92, 0.45),
      transparent
    );
  }

  .creditos p {
    margin: 0;
    font-size: clamp(0.82rem, 0.3vw + 0.75rem, 0.95rem);
    color: rgba(232, 218, 190, 0.75);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.7);
  }

  /* ── Mobile: una columna, todo centrado ── */
  @media (max-width: 768px) {
    section {
      padding: 5rem 0 2.5rem;
    }

    footer {
      grid-template-columns: 1fr;
      gap: 2.75rem;
    }

    .creditos {
      margin-top: 0.5rem;
      padding-top: 1.75rem;
      gap: 0.75rem;
    }

    .creditos p {
      max-width: 34ch;
      text-wrap: balance;
    }
  }
</style>
