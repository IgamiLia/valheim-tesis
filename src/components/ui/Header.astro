---
const links = [
  { href: "/#inicio", label: "Inicio" },
  { href: "/#serie", label: "Serie" },
  { href: "/#personajes", label: "Personajes" },
  { href: "/#mundo", label: "Mundo" },
  { href: "/#biografias", label: "Biografías" },
  { href: "/#musica", label: "Música" },
  // { href: "#contactos", label: "Contactos" },
];
---

<header class="site-header" id="siteHeader">
  <a class="brand" href="/#inicio" aria-label="Inicio">
    <!-- <span class="brand-rune" aria-hidden="true"
      ><img src="/svg/Mval.svg" alt="Rune" /></span
    > -->
    <span class="brand-text">Valheim</span>
  </a>

  <button
    class="nav-toggle"
    id="navToggle"
    aria-label="Abrir menú"
    aria-expanded="false"
    aria-controls="primaryNav"
  >
    <span></span><span></span><span></span>
  </button>

  <nav class="primary-nav" id="primaryNav" aria-label="Navegación principal">
    <ul>
      {
        links.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

{
  /* La lógica (scroll/auto-hide/menú) vive en @utils/headerManager y la
    orquesta navigationManager en cada astro:page-load. */
}

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem clamp(1.25rem, 4vw, 3rem);
    background: linear-gradient(
      to bottom,
      rgba(8, 6, 3, 0.85) 0%,
      rgba(8, 6, 3, 0.45) 60%,
      transparent 100%
    );
    transition:
      transform 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      background 0.4s ease,
      padding 0.35s ease,
      box-shadow 0.4s ease;
  }

  /* Auto-hide: oculto deslizando hacia arriba */
  .site-header.is-hidden {
    transform: translateY(-100%);
  }

  .site-header.is-scrolled {
    background: linear-gradient(
      to bottom,
      rgba(8, 6, 3, 0.97),
      rgba(8, 6, 3, 0.86)
    );
    padding-top: 0.6rem;
    padding-bottom: 0.6rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
  }

  /* Línea rúnica dorada inferior */
  .site-header::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-gold-dark) 20%,
      var(--color-gold) 50%,
      var(--color-gold-dark) 80%,
      transparent
    );
    opacity: 0.7;
    pointer-events: none;
  }

  /* ── Marca ── */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.18em;
    font-size: clamp(1.05rem, 1.4vw + 0.55rem, 1.45rem);
    text-transform: uppercase;
    text-decoration: none;
    background: linear-gradient(
      to bottom,
      var(--color-gold-light),
      var(--color-gold) 55%,
      var(--color-gold-dark)
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 1px 4px rgba(0, 0, 0, 0.85));
  }
  .brand-rune {
    -webkit-text-fill-color: var(--color-gold);
    color: var(--color-gold);
    font-size: 1.15em;
    line-height: 1;
    width: 1.2em;
    height: 1.2em;
    & img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }
  }

  /* ── Navegación ── */
  .primary-nav ul {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.4vw, 2.2rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .primary-nav a {
    position: relative;
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.82rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(220, 195, 120, 0.82);
    text-decoration: none;
    padding: 0.35rem 0;
    transition:
      color 0.3s ease,
      text-shadow 0.3s ease;
  }
  .primary-nav a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-gold),
      transparent
    );
    transform: scaleX(0);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .primary-nav a:hover,
  .primary-nav a:focus-visible {
    color: var(--color-gold-light);
    text-shadow: 0 0 10px var(--color-gold-glow);
  }
  .primary-nav a:hover::after,
  .primary-nav a:focus-visible::after {
    transform: scaleX(1);
  }

  /* ── Botón hamburguesa (oculto en desktop) ── */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 0 9px;
    background: none;
    border: 1px solid var(--color-gold-dark);
    border-radius: 2px;
    cursor: pointer;
  }
  .nav-toggle span {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--color-gold);
    border-radius: 2px;
    transition:
      transform 0.3s ease,
      opacity 0.3s ease;
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .nav-toggle {
      display: inline-flex;
    }
    .site-header.nav-open .nav-toggle span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }
    .site-header.nav-open .nav-toggle span:nth-child(2) {
      opacity: 0;
    }
    .site-header.nav-open .nav-toggle span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }

    .primary-nav {
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      background: linear-gradient(
        to bottom,
        rgba(8, 6, 3, 0.98),
        rgba(8, 6, 3, 0.95)
      );
      border-bottom: 1px solid var(--color-gold-dark);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.45s ease;
    }
    .site-header.nav-open .primary-nav {
      max-height: 75vh;
    }
    .primary-nav ul {
      flex-direction: column;
      gap: 0;
      padding: 0.4rem 0;
    }
    .primary-nav li {
      width: 100%;
      text-align: center;
    }
    .primary-nav li + li {
      border-top: 1px solid var(--color-gold-subtle);
    }
    .primary-nav a {
      display: block;
      padding: 0.95rem;
      font-size: 0.95rem;
    }
    .primary-nav a::after {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .primary-nav,
    .primary-nav a::after,
    .nav-toggle span {
      transition: none;
    }
  }
</style>
