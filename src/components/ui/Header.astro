---
const links = [
  { href: "/#inicio", label: "Inicio", modal: false },
  { href: "/#serie", label: "Serie", modal: false },
  { href: "/#personajes", label: "Personajes", modal: false },
  { href: "/#mundo", label: "Mundo", modal: false },
  { href: "/#biografias", label: "Biografías", modal: false },
  { href: "/#musica", label: "Música", modal: false },
  { href: "#contactos", label: "Contactos", modal: true },
];
---

<header class="site-header" id="siteHeader">
  <a class="brand" href="/#inicio" aria-label="Inicio">
    <span class="brand-text">Valheim</span>
  </a>

  <button
    class="nav-toggle"
    id="navToggle"
    aria-label="Abrir menú"
    aria-expanded="false"
    aria-controls="primaryNav"
  >
    <span></span><span></span><span></span>
  </button>

  <nav class="primary-nav" id="primaryNav" aria-label="Navegación principal">
    <ul>
      {
        links.map((l) =>
          l.modal ? (
            <li>
              <button
                class="rune-link nav-item"
                type="button"
                data-contact-open
              >
                {l.label}
              </button>
            </li>
          ) : (
            <li>
              <a class="rune-link nav-item" href={l.href}>
                {l.label}
              </a>
            </li>
          ),
        )
      }
    </ul>
  </nav>
</header>

<dialog class="contact-modal" id="contactModal" aria-label="Contactos">
  <div class="contact-modal__inner">
    <button
      class="contact-modal__close"
      type="button"
      data-contact-close
      aria-label="Cerrar"
    >
      ✕
    </button>

    <h2 class="contact-modal__title">Contactos</h2>

    <div class="contact-cols">
      <section class="contact-col">
        <h3>Ailén Braga</h3>
        <a
          class="rune-link"
          href="https://wa.me/5491161878722"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="contact-inner">
            <span class="contact-label">WhatsApp</span>
            +54 9 11 6187-8722
          </span>
        </a>
        <a class="rune-link" href="mailto:ailenbragaph@gmail.com">
          <span class="contact-inner">
            <span class="contact-label">Email</span>
            ailenbragaph@gmail.com
          </span>
        </a>
        <a
          class="rune-link"
          href="https://ailenbraga.com"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="contact-inner">
            <span class="contact-label">Portfolio</span>
            ailenbraga.com
          </span>
        </a>
      </section>

      <section class="contact-col">
        <h3>Matías Aguirre</h3>
        <a
          class="rune-link"
          href="https://wa.me/5491166289713"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="contact-inner">
            <span class="contact-label">WhatsApp</span>
            +54 9 11 6628-9713
          </span>
        </a>
        <a class="rune-link" href="mailto:matt.aguirre.dev@gmail.com">
          <span class="contact-inner">
            <span class="contact-label">Email</span>
            matt.aguirre.dev@gmail.com
          </span>
        </a>
        <a
          class="rune-link"
          href="https://mattecocido.com"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="contact-inner">
            <span class="contact-label">Portfolio</span>
            mattecocido.com
          </span>
        </a>
      </section>
    </div>

    <a
      class="valheim-link"
      href="https://www.valheimgame.com/es/"
      target="_blank"
      rel="noopener noreferrer"
    >
      Página oficial de Valheim
    </a>
  </div>
</dialog>

{
  /* La lógica (scroll/auto-hide/menú/modal) vive en @utils/headerManager y la
    orquesta navigationManager en cada astro:page-load. */
}

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem clamp(1.25rem, 4vw, 3rem);
    background: linear-gradient(
      to bottom,
      rgba(8, 6, 3, 0.85) 0%,
      rgba(8, 6, 3, 0.45) 60%,
      transparent 100%
    );
    transition:
      transform 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      background 0.4s ease,
      padding 0.35s ease,
      box-shadow 0.4s ease;
  }

  /* Auto-hide: oculto deslizando hacia arriba */
  .site-header.is-hidden {
    transform: translateY(-100%);
  }

  .site-header.is-scrolled {
    background: linear-gradient(
      to bottom,
      rgba(8, 6, 3, 0.97),
      rgba(8, 6, 3, 0.86)
    );
    padding-top: 0.6rem;
    padding-bottom: 0.6rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
  }

  /* Línea rúnica dorada inferior */
  .site-header::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-gold-dark) 20%,
      var(--color-gold) 50%,
      var(--color-gold-dark) 80%,
      transparent
    );
    opacity: 0.7;
    pointer-events: none;
  }

  /* ── Marca ── */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.18em;
    font-size: clamp(1.05rem, 1.4vw + 0.55rem, 1.45rem);
    text-transform: uppercase;
    text-decoration: none;
    background: linear-gradient(
      to bottom,
      var(--color-gold-light),
      var(--color-gold) 55%,
      var(--color-gold-dark)
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 1px 4px rgba(0, 0, 0, 0.85));
  }
  .brand-rune {
    -webkit-text-fill-color: var(--color-gold);
    color: var(--color-gold);
    font-size: 1.15em;
    line-height: 1;
    width: 1.2em;
    height: 1.2em;
    & img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }
  }

  /* ── Navegación ── */
  .primary-nav ul {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.4vw, 2.2rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .primary-nav .nav-item {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.82rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(220, 195, 120, 0.82);
    text-decoration: none;
    padding: 0.35rem 0;
    /* reset para el <button> de Contactos */
    background: none;
    border: 0;
    cursor: pointer;
    transition:
      color 0.3s ease,
      text-shadow 0.3s ease;
  }
  .primary-nav .nav-item:hover,
  .primary-nav .nav-item:focus-visible {
    color: var(--color-gold-light);
    text-shadow: 0 0 10px var(--color-gold-glow);
  }

  /* Hover estilo menú del juego: runas (rune-icon.svg) que flanquean el texto.
     Clase reutilizable (ítems de nav + botón de Valheim del modal). Los
     pseudo-elementos van en posición absoluta → no alteran el layout flex. */
  .rune-link {
    position: relative;
  }
  .rune-link::before,
  .rune-link::after {
    content: "";
    position: absolute;
    top: 50%;
    width: 1.5em;
    height: 1em;
    background: url("/svg/rune-icon.svg") no-repeat center / contain;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.3s ease,
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .rune-link::before {
    right: 100%;
    margin-right: 0.55rem;
    transform: translate(0.35rem, -50%);
  }
  .rune-link::after {
    left: 100%;
    margin-left: 0.55rem;
    transform: translate(-0.35rem, -50%) scaleX(-1);
  }
  .rune-link:hover::before,
  .rune-link:focus-visible::before {
    opacity: 1;
    transform: translate(0, -50%);
  }
  .rune-link:hover::after,
  .rune-link:focus-visible::after {
    opacity: 1;
    transform: translate(0, -50%) scaleX(-1);
  }

  /* ── Modal de contactos ── */
  .contact-modal {
    margin: auto;
    width: min(92vw, 640px);
    padding: 0;
    border: var(--card-border-width) solid var(--color-gold-dark);
    border-radius: 3px;
    background: linear-gradient(
      180deg,
      rgba(14, 10, 4, 0.98),
      rgba(8, 6, 3, 0.98)
    );
    color: var(--color-gold-light);
    box-shadow:
      0 0 0 1px rgba(10, 9, 6, 0.8),
      0 0 0 4px var(--color-gold-dark),
      0 0 40px 6px rgba(130, 103, 40, 0.4);
    overflow: hidden;
  }
  .contact-modal::backdrop {
    background: rgba(4, 3, 1, 0.82);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
  .contact-modal__inner {
    position: relative;
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }
  .contact-modal__close {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    width: 2rem;
    height: 2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: 1px solid var(--color-gold-dark);
    border-radius: 2px;
    color: var(--color-gold-light);
    font-size: 0.85rem;
    cursor: pointer;
    transition: all var(--transition-fast);
  }
  .contact-modal__close:hover {
    color: var(--color-gold);
    border-color: var(--color-gold);
    box-shadow: 0 0 12px var(--color-gold-glow);
  }
  .contact-modal__title {
    text-align: center;
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: clamp(1.2rem, 3.5vw, 1.7rem);
    color: var(--color-gold-light);
    text-shadow: 0 0 16px var(--color-gold-glow);
    margin-bottom: 1.6rem;
  }
  .contact-cols {
    display: flex;
    gap: clamp(1rem, 4vw, 2.5rem);
  }
  .contact-col {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    text-align: center;
  }
  .contact-col h3 {
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: 0.08em;
    color: var(--color-gold);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-gold-dark);
  }
  .contact-col a {
    /* Ángulo de giro del texto en hover. */
    --rot: 3deg;
    display: flex;
    justify-content: center;
    width: fit-content;
    max-width: 100%;
    margin-inline: auto;
    color: rgba(225, 205, 150, 0.92);
    text-decoration: none;
    font-size: 0.92rem;
    word-break: break-word;
    transition:
      color var(--transition-fast),
      transform var(--transition-fast),
      text-shadow var(--transition-fast);
  }
  /* El texto vive en un wrapper interno: así puede rotar SOLO el texto y las
     runas (pseudos del enlace) quedan alineadas, sin importar la rotación. */
  .contact-inner {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    align-items: center;
    transition: transform var(--transition-fast);
  }
  .contact-col a:hover,
  .contact-col a:focus-visible {
    color: #ffce3a;
    text-shadow: 0 0 12px rgba(255, 200, 60, 0.55);
  }
  .contact-col a:hover .contact-inner,
  .contact-col a:focus-visible .contact-inner {
    transform: scale(1.08) rotate(var(--rot));
  }
  .contact-label {
    font-family: var(--font-display);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gold-dark);
  }

  /* Botón a la web oficial de Valheim — mismo hover de runas que el header */
  .valheim-link {
    display: block;
    width: fit-content;
    margin: 2rem auto 0;
    padding: 0.7rem 1.6rem;
    font-family: var(--font-display);
    font-size: 0.92rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-align: center;
    text-decoration: none;
    color: var(--color-gold-light);
    border: 1px solid var(--color-gold-dark);
    border-radius: 2px;
    background: linear-gradient(
      180deg,
      rgba(100, 78, 15, 0.25),
      rgba(40, 28, 4, 0.35)
    );
    transition: all var(--transition-fast);
  }
  .valheim-link:hover,
  .valheim-link:focus-visible {
    color: #ffce3a;
    border-color: var(--color-gold);
    box-shadow: 0 0 16px var(--color-gold-glow);
    text-shadow: 0 0 10px rgba(255, 200, 60, 0.55);
    transform: scale(1.06);
  }

  @media (max-width: 560px) {
    .contact-cols {
      flex-direction: column;
    }
  }

  /* Desktop: modal y tipografía más grandes. */
  @media (min-width: 769px) {
    .contact-modal {
      width: min(90vw, 820px);
    }
    .contact-modal__inner {
      padding: 3rem;
    }
    .contact-modal__title {
      font-size: 2.1rem;
      margin-bottom: 2rem;
    }
    .contact-col h3 {
      font-size: 1.35rem;
    }
    .contact-col a {
      font-size: 1.1rem;
    }
    .contact-label {
      font-size: 0.82rem;
    }
    .valheim-link {
      font-size: 1.05rem;
      padding: 0.85rem 2.2rem;
    }
  }

  /* ── Botón hamburguesa (oculto en desktop) ── */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 0 9px;
    background: none;
    border: 1px solid var(--color-gold-dark);
    border-radius: 2px;
    cursor: pointer;
  }
  .nav-toggle span {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--color-gold);
    border-radius: 2px;
    transition:
      transform 0.3s ease,
      opacity 0.3s ease;
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .nav-toggle {
      display: inline-flex;
    }
    .site-header.nav-open .nav-toggle span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }
    .site-header.nav-open .nav-toggle span:nth-child(2) {
      opacity: 0;
    }
    .site-header.nav-open .nav-toggle span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }

    .primary-nav {
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      background: linear-gradient(
        to bottom,
        rgba(8, 6, 3, 0.98),
        rgba(8, 6, 3, 0.95)
      );
      border-bottom: 1px solid var(--color-gold-dark);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.45s ease;
    }
    .site-header.nav-open .primary-nav {
      max-height: 75vh;
    }
    .primary-nav ul {
      flex-direction: column;
      gap: 0;
      padding: 0.4rem 0;
    }
    .primary-nav li {
      width: 100%;
      text-align: center;
    }
    .primary-nav li + li {
      border-top: 1px solid var(--color-gold-subtle);
    }
    .primary-nav .nav-item {
      display: block;
      width: 100%;
      padding: 0.95rem;
      font-size: 0.95rem;
    }
    .primary-nav .rune-link::before,
    .primary-nav .rune-link::after {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .primary-nav,
    .rune-link::before,
    .rune-link::after,
    .nav-toggle span {
      transition: none;
    }
  }
</style>
