---
import Tooltip from "@components/ui/Tooltip.astro";
const { name, img, id, title } = Astro.props;
const _segs = img.split("/");
const _file = _segs.at(-1)!;
const _baseName = _file.replace(/\.[^.]+$/, "");
const _parentDir = _segs.slice(0, -2).join("/");
const avifSrc = `${_parentDir}/avif/${_baseName}.avif`;
const webpSrc = `${_parentDir}/webp/${_baseName}.webp`;
---

<article class="char-container" id={id} data-tooltip={title}>
  <div class="char-tilt">
    <section class="char-overlay">
      <div class="corner-tr"></div>
      <div class="corner-bl"></div>
      <div class="rune-band"></div>
      <picture>
        <source srcset={avifSrc} type="image/avif" />
        <source srcset={webpSrc} type="image/webp" />
        <img
          class="char-img"
          src={img}
          alt={name}
          loading="lazy"
          decoding="async"
        />
      </picture>
    </section>
    <span class="char-name">{name}</span>
  </div>
</article>

<style>
  picture {
    display: contents;
  }

  .char-container {
    perspective: 900px;
  }

  .char-tilt {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg))
      translateZ(var(--tz, 0px));
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .char-container.is-tilting .char-tilt {
    transition: transform 0.08s linear;
  }

  .char-overlay {
    position: relative;
  }

  .char-overlay::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(
      circle at var(--gx, 50%) var(--gy, 50%),
      rgba(240, 227, 191, 0.15),
      transparent 45%
    );
    transition: opacity 0.3s ease;
    mix-blend-mode: overlay;
    z-index: 6;
  }

  .char-container.is-tilting .char-overlay::after {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .char-tilt {
      transition: none;
      transform: none !important;
    }

    .char-overlay::after {
      display: none;
    }
  }
</style>

<script>
  const RUNES = [
    "ᚠ",
    "ᚢ",
    "ᚦ",
    "ᚨ",
    "ᚱ",
    "ᚲ",
    "ᚷ",
    "ᚹ",
    "ᚺ",
    "ᚾ",
    "ᛁ",
    "ᛃ",
    "ᛇ",
    "ᛈ",
    "ᛉ",
    "ᛊ",
    "ᛏ",
    "ᛒ",
    "ᛖ",
    "ᛗ",
    "ᛚ",
    "ᛜ",
    "ᛞ",
    "ᛟ",
  ];

  document.querySelectorAll<HTMLElement>(".rune-band").forEach((band) => {
    const count = Math.floor(band.offsetWidth / 13) + 4;
    band.innerHTML = Array.from({ length: count }, (_, i) => {
      const r = RUNES[Math.floor(Math.random() * RUNES.length)];
      return `<span style="animation-delay:${(i * 0.11).toFixed(2)}s">${r}</span>`;
    }).join("");
  });

  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (!reduceMotion) {
    const MAX_TILT = 12; // deg
    const MAX_TZ = 20; // px

    document
      .querySelectorAll<HTMLElement>(".char-container")
      .forEach((card) => {
        const tilt = card.querySelector<HTMLElement>(".char-tilt");
        if (!tilt) return;

        let rafId: number | null = null;
        let pendingX = 0;
        let pendingY = 0;
        let pendingGx = 50;
        let pendingGy = 50;

        const apply = () => {
          tilt.style.setProperty("--ry", `${pendingX * MAX_TILT}deg`);
          tilt.style.setProperty("--rx", `${-pendingY * MAX_TILT}deg`);
          tilt.style.setProperty("--tz", `${MAX_TZ}px`);
          tilt.style.setProperty("--gx", `${pendingGx}%`);
          tilt.style.setProperty("--gy", `${pendingGy}%`);
          rafId = null;
        };

        const onMove = (e: PointerEvent) => {
          const rect = card.getBoundingClientRect();
          const px = (e.clientX - rect.left) / rect.width;
          const py = (e.clientY - rect.top) / rect.height;

          pendingX = px * 2 - 1;
          pendingY = py * 2 - 1;
          pendingGx = px * 100;
          pendingGy = py * 100;

          if (rafId === null) rafId = requestAnimationFrame(apply);
        };

        const onEnter = () => card.classList.add("is-tilting");

        const onLeave = () => {
          card.classList.remove("is-tilting");
          tilt.style.setProperty("--rx", "0deg");
          tilt.style.setProperty("--ry", "0deg");
          tilt.style.setProperty("--tz", "0px");
          tilt.style.setProperty("--gx", "50%");
          tilt.style.setProperty("--gy", "50%");
        };

        card.addEventListener("pointerenter", onEnter);
        card.addEventListener("pointermove", onMove);
        card.addEventListener("pointerleave", onLeave);
      });
  }
</script>
