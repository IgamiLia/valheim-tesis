---
import type { Biografia } from "@data/biografias";

/**
 * Biografía parallax (mobile). Renderiza UNA biografía; index.astro hace el
 * loop y coloca el ancla de navegación en un wrapper compartido con
 * <Parallax> (desktop), evitando ids duplicados en el DOM.
 */
interface Props {
  bio: Biografia;
  /** true para la primera biografía: su imagen carga eager. */
  eager?: boolean;
}

const { bio, eager = false } = Astro.props;
const ext = bio.ext ?? "webp";
---

<article class="pm-scene" aria-label={`Biografía de ${bio.name}`}>
  <div class="pm-pin">
    <img
      src={`/images/parallax/mobile/${ext}/parallax-mobile-${bio.slug}.${ext}`}
      alt=""
      class="pm-img"
      loading={eager ? "eager" : "lazy"}
      decoding="async"
    />
    <div class="pm-fade-top"></div>
    <div class="pm-fade-bot"></div>
    <h2 class="pm-name">{bio.name}</h2>
  </div>
  <div class="pm-story">
    {
      bio.paragraphs.map((p, j) => (
        <p class:list={["pm-p", { "pm-p--first": j === 0 }]} set:html={p} />
      ))
    }
  </div>
</article>

<script>
  // ── Estado de módulo: los observers se recrean en cada astro:page-load
  //    (con ClientRouter el DOM se reemplaza y los nodos viejos mueren). ──
  let paragraphIO: IntersectionObserver | null = null;
  let sceneIO: IntersectionObserver | null = null;
  let onScroll: (() => void) | null = null;

  function initParallaxMobile() {
    paragraphIO?.disconnect();
    sceneIO?.disconnect();
    if (onScroll) window.removeEventListener("scroll", onScroll);
    paragraphIO = sceneIO = onScroll = null;

    const paragraphs = document.querySelectorAll<HTMLElement>(".pm-p");
    if (!paragraphs.length) return;

    // Estado oculto aplicado desde JS (progressive enhancement): si el
    // script no corre, los párrafos quedan visibles por defecto.
    paragraphIO = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          e.target.classList.toggle("pm-p--visible", e.isIntersecting);
        });
      },
      {
        threshold: 0.05,
        rootMargin: "-6% 0px -6% 0px",
      },
    );

    paragraphs.forEach((p) => {
      p.classList.add("pm-p--anim");
      paragraphIO!.observe(p);
    });

    // ── Cámara + parallax: progreso de scroll por escena en --p ──
    const scenes = document.querySelectorAll<HTMLElement>(".pm-scene");
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce || !scenes.length) return;

    const active = new Set<HTMLElement>();
    sceneIO = new IntersectionObserver(
      (es) =>
        es.forEach((e) => {
          const el = e.target as HTMLElement;
          e.isIntersecting ? active.add(el) : active.delete(el);
          el.classList.toggle("is-active", e.isIntersecting);
        }),
      { rootMargin: "12% 0px 12% 0px" },
    );
    scenes.forEach((s) => sceneIO!.observe(s));

    let ticking = false;
    const ease = (t: number) => t * t * (3 - 2 * t); // smoothstep → "peso"
    const update = () => {
      const vh = window.innerHeight;
      active.forEach((s) => {
        const r = s.getBoundingClientRect();
        const p = Math.min(Math.max(-r.top / (r.height - vh || 1), 0), 1);
        s.style.setProperty("--p", ease(p).toFixed(3));
      });
      ticking = false;
    };
    onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    update();
  }

  // Corre en la carga inicial Y tras cada navegación SPA.
  document.addEventListener("astro:page-load", initParallaxMobile);
</script>

<style>
  /* ── Escena: solo visible en mobile; altura determinada por el texto ──
     En desktop se reemplaza por <Parallax>. */
  .pm-scene {
    position: relative;
    display: none;
    --p: 0; /* progreso de scroll (0→1) seteado por el controlador rAF */
  }

  @media (max-width: 768px) {
    .pm-scene {
      display: block;
    }
  }

  /* ────────────────────────────────────────────
     PIN: imagen fija durante todo el scroll de
     la escena. Se queda en top:0 mientras su
     padre tenga espacio para contenerla.
  ──────────────────────────────────────────── */
  .pm-pin {
    position: sticky;
    top: 0;
    /* lvh = viewport con la barra de URL oculta: evita la franja vacía al
       pie cuando la barra se esconde (100svh quedaba más corto que el viewport). */
    height: 100lvh;
    overflow: hidden;
    z-index: 0;
  }

  /* Viñeta cinematográfica */
  .pm-pin::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(
      132% 100% at 50% 40%,
      transparent 56%,
      rgba(0, 0, 0, 0.38) 100%
    );
  }

  /* Niebla sutil + variación de luz (solo corre en la escena activa) */
  .pm-pin::before {
    content: "";
    position: absolute;
    inset: -20%;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(
        38% 30% at 30% 38%,
        rgba(222, 233, 248, 0.06),
        transparent 70%
      ),
      radial-gradient(
        44% 34% at 72% 56%,
        rgba(222, 233, 248, 0.05),
        transparent 70%
      );
    opacity: 0;
    animation: pm-fog 34s ease-in-out infinite alternate;
    animation-play-state: paused;
  }
  .pm-scene.is-active .pm-pin::before {
    animation-play-state: running;
  }

  @keyframes pm-fog {
    0% {
      transform: translate3d(-3%, 2%, 0);
      opacity: 0.5;
    }
    50% {
      opacity: 1;
    }
    100% {
      transform: translate3d(3%, -2%, 0);
      opacity: 0.65;
    }
  }

  .pm-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    transform-origin: 50% 42%; /* push-in hacia el rostro */
    /* base 1.04 cubre la deriva de -2% sin revelar bordes */
    transform: translate3d(0, calc(var(--p) * -2%), 0)
      scale(calc(1.04 + 0.06 * var(--p)));
  }
  .pm-scene.is-active .pm-img {
    will-change: transform;
  }

  /* Gradientes del pin (sobre la imagen) */
  .pm-fade-top {
    position: absolute;
    inset: 0 0 auto;
    height: 18%;
    background: linear-gradient(to bottom, rgb(0, 0, 0), transparent);
    z-index: 1;
    pointer-events: none;
  }

  .pm-fade-bot {
    position: absolute;
    inset: 0; /* cubre el pin; el degradado deja libre la parte alta */
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(
        135% 78% at 50% 116%,
        rgba(0, 0, 0, 0.92) 0%,
        rgba(0, 0, 0, 0.55) 36%,
        transparent 70%
      ),
      linear-gradient(to top, rgba(0, 0, 0, 0.5), transparent 42%);
  }

  /* Nombre del personaje (dentro del pin, siempre encima) */
  .pm-name {
    position: absolute;
    top: 2.75rem;
    left: 1.5rem;
    z-index: 2;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 13vw, 4.5rem);
    font-weight: 700;
    letter-spacing: 6px;
    line-height: 1;
    /* Foreground: deriva más rápido que el fondo y se desvanece al avanzar */
    transform: translate3d(0, calc(var(--p) * -3.5svh), 0);
    opacity: calc(1 - 0.4 * var(--p));
    background: linear-gradient(
      to bottom,
      rgb(255, 252, 220) 0%,
      rgb(242, 214, 116) 18%,
      rgb(205, 170, 80) 68%,
      rgb(180, 151, 76) 78%,
      rgb(145, 114, 46) 88%,
      rgb(95, 72, 22) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.95))
      drop-shadow(0 4px 20px rgba(0, 0, 0, 0.75));
  }
  .pm-scene.is-active .pm-name {
    will-change: transform, opacity;
  }

  /* Línea decorativa bajo el nombre */
  .pm-name::after {
    content: "";
    position: absolute;
    bottom: -0.25em;
    left: 0;
    width: 70%;
    height: 1px;
    background: linear-gradient(
      to right,
      rgba(210, 175, 88, 0.95),
      rgba(180, 151, 76, 0.5) 55%,
      transparent
    );
  }

  /* ────────────────────────────────────────────
     STORY: el contenedor del texto.

     margin-top: -100svh → empieza en el mismo Y
     que el pin (solapado).

     padding-top: 115svh → el texto queda a 15svh
     bajo el viewport cuando el sticky empieza,
     dando un instante de imagen sola antes de
     que el texto empiece a subir.

     padding-bottom: 65svh → espacio negro después
     del texto para que la imagen salga de pantalla
     antes de que entre la siguiente escena.

     El gradiente de fondo pasa de transparent
     (mientras la imagen está sola) a negro sólido
     (donde está el texto), cubriendo el pin.
  ──────────────────────────────────────────── */
  .pm-story {
    position: relative;
    z-index: 1;
    margin-top: -100lvh; /* coincide con la altura del pin (100lvh) */
    padding-top: 115svh;
    padding-bottom: 65svh;
    padding-left: 1.5rem;
    padding-right: 1.5rem;

    background: linear-gradient(
      to bottom,
      transparent 0,
      transparent 72svh,
      rgba(0, 0, 0, 0.3) 90svh,
      rgba(0, 0, 0, 0.62) 106svh,
      rgba(0, 0, 0, 0.8) 122svh,
      /* zona de lectura: la ilustración sigue visible */ rgba(0, 0, 0, 0.96)
        150svh /* cola: separación entre escenas */
    );
  }

  /* ── Párrafos ── */
  .pm-p {
    font-family: var(--font-body);
    font-size: clamp(0.875rem, 3.8vw, 1rem);
    line-height: 1.85;
    color: rgb(232, 218, 190);
    letter-spacing: 0.022em;
    word-spacing: 0.06em;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.8);
    margin: 0;
    padding: 0.35rem 0;

    transition:
      opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .pm-p + .pm-p {
    margin-top: 1.2em;
  }

  /* Estado inicial (invisible y desplazado): lo aplica JS al arrancar los
     observers. Sin JS los párrafos quedan visibles — progressive enhancement. */
  .pm-p--anim:not(.pm-p--visible) {
    opacity: 0;
    transform: translateY(1.8rem);
  }

  /* Drop cap en el primer párrafo */
  .pm-p--first::first-letter {
    font-family: var(--font-display);
    font-size: 3.1em;
    font-weight: 700;
    line-height: 0.75;
    float: left;
    margin-right: 0.09em;
    margin-top: 0.22em;
    color: rgb(180, 151, 76);
    text-shadow:
      0 0 20px rgba(180, 151, 76, 0.5),
      0 2px 6px rgba(0, 0, 0, 0.9);
  }

  .pm-p :global(strong) {
    font-weight: 600;
    color: rgb(222, 196, 128);
    text-shadow: 0 0 10px rgba(180, 151, 76, 0.2);
    letter-spacing: 0.03em;
  }

  /* ── Accesibilidad: sin movimiento ── */
  @media (prefers-reduced-motion: reduce) {
    .pm-img,
    .pm-name {
      transform: none;
    }
    .pm-pin::before {
      animation: none;
      opacity: 0.5;
    }
  }
</style>