---
import type { Biografia } from "@data/biografias";

/**
 * Biografía parallax (desktop). Renderiza UNA biografía; index.astro hace el
 * loop y coloca el ancla de navegación en un wrapper compartido con
 * <ParallaxMobile>, evitando ids duplicados en el DOM.
 */
interface Props {
  bio: Biografia;
}

const { bio } = Astro.props;
---

<section
  class:list={["parallax", `parallax--${bio.slug}`]}
  aria-label={`Biografía de ${bio.name}`}
>
  <div class="content">
    <div class="card">
      <h2>{bio.name}</h2>
      <div class="text-wrap">
        <div class="vignette"></div>
        {
          bio.paragraphs.map((paragraph, i) => (
            <p
              class:list={["parallax-text", { "first-p": i === 0 }]}
              set:html={paragraph}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>
<style>
  .parallax {
    width: 100%;
    min-height: 100svh;
    background-attachment: fixed;
    background-size: cover;
    background-position: center;
    display: flex;
    justify-content: center;
    align-items: center;
    scroll-snap-align: start;
    position: relative;
  }

  .parallax::before,
  .parallax::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    pointer-events: none;
    z-index: 10;
  }

  .parallax::before {
    top: 0;
    height: 15%;
    background: linear-gradient(to bottom, rgb(0, 0, 0), transparent);
  }

  .parallax::after {
    bottom: 0;
    height: 15%;
    background: linear-gradient(to top, rgb(0, 0, 0), transparent);
  }

  .parallax--einar {
    background-image: url("/images/parallax/png/parallax-einar.png");
    background-image: image-set(
      url("/images/parallax/avif/parallax-einar.avif") type("image/avif"),
      url("/images/parallax/webp/parallax-einar.webp") type("image/webp")
    );
  }
  .parallax--runa {
    background-image: url("/images/parallax/png/parallax-runa.png");
    background-image: image-set(
      url("/images/parallax/avif/parallax-runa.avif") type("image/avif"),
      url("/images/parallax/webp/parallax-runa.webp") type("image/webp")
    );
  }
  .parallax--stalker {
    background-image: url("/images/parallax/png/parallax-stalker.png");
    background-image: image-set(
      url("/images/parallax/avif/parallax-stalker.avif") type("image/avif"),
      url("/images/parallax/webp/parallax-stalker.webp") type("image/webp")
    );
  }
  .parallax--hel {
    background-image: url("/images/parallax/png/parallax-hel.png");
    background-image: image-set(
      url("/images/parallax/avif/parallax-hel.avif") type("image/avif"),
      url("/images/parallax/webp/parallax-hel.webp") type("image/webp")
    );
  }
  .parallax--moder {
    background-image: url("/images/parallax/png/parallax-moder.png");
    background-image: image-set(
      url("/images/parallax/avif/parallax-moder.avif") type("image/avif"),
      url("/images/parallax/webp/parallax-moder.webp") type("image/webp")
    );
  }
  .parallax--fader {
    background-image: url("/images/parallax/png/parallax-fader.png");
    background-image: image-set(
      url("/images/parallax/avif/parallax-fader.avif") type("image/avif"),
      url("/images/parallax/webp/parallax-fader.webp") type("image/webp")
    );
  }

  .content {
    color: #fefefe;
    text-align: center;
    padding: 50px;
    width: 100%;
    height: 100%;
  }

  .card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    width: 100%;
    height: 100%;
    max-width: 110ch;
    gap: 1.75rem;
    /* Aire respecto a los bordes; vertical en vh para despegarse de los
       degradados negros del 15% (superior e inferior) en desktop. */
    padding: clamp(9rem, 18vh, 14rem) clamp(2.5rem, 5vw, 5rem)
      clamp(5rem, 14vh, 10rem);
    text-align: start;
    text-wrap: balance;
  }

  /* ── H2 base (mismo posicionamiento para todos los nombres) ── */
  .card h2 {
    height: fit-content;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(5rem, 11.0803vw + 1.6898rem, 8rem);
    font-weight: 700;
    font-feature-settings:
      "liga" 1,
      "kern" 1;
    position: relative;
    z-index: 2;
    letter-spacing: 8px;
    background: linear-gradient(
      to bottom,
      rgb(255, 252, 220) 0%,
      rgb(242, 214, 116) 18%,
      rgb(205, 170, 80) 68%,
      rgb(180, 151, 76) 78%,
      rgb(145, 114, 46) 88%,
      rgb(95, 72, 22) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-shadow:
      0 0 20px rgba(200, 165, 70, 0.6),
      0 0 60px rgba(180, 151, 76, 0.25),
      0 6px 16px rgba(0, 0, 0, 0.75);
    /* Sombra fuerte para legibilidad sobre cualquier fondo (claro u oscuro) */
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.95))
      drop-shadow(0 4px 16px rgba(0, 0, 0, 0.7));
  }

  /* Línea decorativa debajo del nombre */
  .card h2::after {
    content: "";
    position: absolute;
    bottom: 0.05em;
    left: 0;
    width: 65%;
    height: 1px;
    background: linear-gradient(
      to right,
      rgba(210, 175, 88, 0.95) 0%,
      rgba(180, 151, 76, 0.5) 55%,
      transparent 100%
    );
  }

  .text-wrap {
    position: relative;
    height: fit-content;
    max-width: 100ch;
  }

  .vignette {
    position: absolute;
    inset: -10% -10%;
    z-index: 0;
    background: radial-gradient(
      ellipse at 45% 50%,
      rgba(0, 0, 0, 0.88) 0%,
      rgba(0, 0, 0, 0.72) 35%,
      rgba(0, 0, 0, 0.38) 60%,
      transparent 100%
    );
    filter: url(#roughen);
    pointer-events: none;
  }

  /* ── Párrafos ── */
  .card p {
    position: relative;
    z-index: 2;
    font-family: var(--font-body);
    font-size: clamp(0.875rem, 1.2vw + 1rem, 2rem);
    line-height: 1.85;
    color: rgb(232, 218, 190);
    letter-spacing: 0.025em;
    word-spacing: 0.08em;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6);
    margin: 0;
    padding: 0.5rem 0;
  }

  .card p + p {
    margin-top: 1.1em;
  }

  .card p.first-p::first-letter {
    font-family: var(--font-display);
    font-size: 3.5em;
    font-weight: 700;
    line-height: 0.75;
    float: left;
    margin-right: 0.09em;
    margin-top: 0.2em;
    color: rgb(180, 151, 76);
    text-shadow:
      0 0 24px rgba(180, 151, 76, 0.5),
      0 2px 6px rgba(0, 0, 0, 0.8);
  }

  .card p :global(strong) {
    font-weight: 600;
    color: rgb(222, 196, 128);
    text-shadow: 0 0 10px rgba(180, 151, 76, 0.2);
    letter-spacing: 0.03em;
  }

  @media (max-width: 900px) {
    .card {
      padding-top: 4rem;
      gap: 1.25rem;
    }
    .text-wrap {
      max-width: 100%;
    }
    .vignette {
      inset: -5% -5%;
    }
  }

  /* En mobile se reemplaza por <ParallaxMobile> */
  @media (max-width: 768px) {
    .parallax {
      display: none;
    }
  }
</style>
